{
  "name": "bossflow",
  "displayName": "BossFlow",
  "version": "1.1.0",
  "private": true,
  "description": "非官方社区维护的求职筛选与投递效率工具",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "dev:firefox": "wxt -b firefox",
    "postinstall": "wxt prepare",
    "check": "vue-tsc --noEmit",
    "build": "run-p build:chrome build:firefox build:edge",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "zip": "run-p zip:chrome zip:firefox zip:edge",
    "zip:chrome": "wxt zip -b chrome",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.16",
    "@ai-sdk/provider": "^4.0.18",
    "@nuxt/ui": "^4.10.0",
    "@vueuse/integrations": "^14.2.1",
    "ai": "^7.0.31",
    "codejar": "^4.3.0",
    "comctx": "^1.6.1",
    "idb": "^8.0.3",
    "mqtt": "^5.15.1",
    "partial-json": "^0.1.7",
    "serialize-error": "^13.0.1",
    "spark-md5": "^3.0.2",
    "tailwindcss": "^4.3.1",
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.1.1",
    "@types/spark-md5": "^3.0.5",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^14.2.1",
    "@wxt-dev/module-vue": "^1.0.3",
    "lint-staged": "^17.0.7",
    "npm-run-all": "^4.1.5",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.60.0",
    "oxlint-tsgolint": "^0.25.0",
    "proto2api": "^0.0.8",
    "protobufjs": "^8.6.3",
    "sass": "^1.99.0",
    "ts-proto": "^2.11.6",
    "typescript": "~5.9.3",
    "uid": "^2.0.2",
    "vite-plugin-tailwind-shadowdom": "^1.1.1",
    "vue-tsc": "^3.2.6",
    "wxt": "^0.20.26"
  },
  "overrides": {
    "vite": "^8.0.16"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "oxlint --fix"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "vue-demi"
    ]
  }
}
